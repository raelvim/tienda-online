# URI de conexión de tu clúster gratuito de MongoDB Atlas (ver README.md)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/tienda

# Cadena secreta larga y aleatoria para firmar las sesiones de admin (inventá una)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Contraseña de admin que se usará SOLO la primera vez que arranque el servidor
ADMIN_PASSWORD=admin123

# Puerto en el que corre el servidor (Render lo define solo, esto es para probar local)
PORT=4000

# Dominio de tu tienda publicada (Netlify), separado por comas si hay más de uno
CORS_ORIGIN=https://tu-tienda.netlify.app,http://localhost:5500
